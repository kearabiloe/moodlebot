{
  "manifest_version": 3,
  "name": "MoodleBot",
  "version": "1.0",
  "description": "MoodleBot extracts questions from a Moodle page, retrieves answers from ChatGPT and sends answers via Whatsapp",
  "permissions": [
    "activeTab",
    "downloads",
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://moodlebot.crowdcoin.co.za/"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "Extract": {
      "suggested_key": {
        "default": "Ctrl+Shift+H"
      },
      "description": "Trigger Extraction"
    },
    "SavePDF": {
      "suggested_key": {
        "default": "Ctrl+Shift+F"
      },
      "description": "Trigger SavePDF"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
